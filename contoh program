<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StudyMate AI - Asisten Belajar Pintar Siswa SMA</title>
  <!-- Tailwind CSS CDN untuk Styling Modern -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontInter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between">

  <!-- NAVBAR -->
  <nav class="border-b border-slate-800 bg-slate-900/80 backdrop-blur fixed w-full z-10">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span class="bg-indigo-600 text-white p-2 rounded-lg font-bold text-xl">⚡</span>
        <span class="font-extrabold text-xl tracking-tight text-white">StudyMate<span class="text-indigo-400">.AI</span></span>
      </div>
      <a href="#pricing" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold px-4 py-2 rounded-lg text-sm transition">Berlangganan</a>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <header class="pt-32 pb-16 px-4 text-center max-w-4xl mx-auto">
    <span class="bg-indigo-500/10 text-indigo-400 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider border border-indigo-500/20">
      🤖 Platform AI Wirausaha Siswa
    </span>
    <h1 class="text-4xl md:text-6xl font-extrabold mt-6 text-white leading-tight">
      Rangkum Materi & Buat Jadwal Belajar dalam <span class="text-indigo-400">Hitungan Detik</span>
    </h1>
    <p class="text-slate-400 text-base md:text-lg mt-4 max-w-2xl mx-auto">
      Solusi pintar AI untuk siswa SMA. Hemat waktu belajar hingga 70% dan tingkatkan nilai ujianmu sekarang juga!
    </p>
  </header>

  <!-- INTERACTIVE DEMO (CORE FEATURE) -->
  <section class="max-w-3xl mx-auto px-4 w-full mb-16">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 shadow-2xl">
      <h2 class="text-xl font-bold mb-4 text-slate-100 flex items-center gap-2">
        <span>✨</span> Coba Generator Rangkuman AI
      </h2>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Pilih Mata Pelajaran:</label>
          <select id="subject" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-slate-200 focus:outline-none focus:border-indigo-500">
            <option value="Biologi">Biologi - Genetika & DNA</option>
            <option value="Matematika">Matematika - Turunan & Integral</option>
            <option value="Sejarah">Sejarah - Proklamasi Kemerdekaan</option>
            <option value="Fisika">Fisika - Hukum Newton & Gelombang</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Tempelkan Catatan / Topik Belajar:</label>
          <textarea id="inputNotes" rows="3" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-slate-200 focus:outline-none focus:border-indigo-500 placeholder-slate-500" placeholder="Ketik topik atau bagian bab yang ingin dirangkum..."></textarea>
        </div>
        <button onclick="generateSummary()" class="w-full bg-indigo-600 hover:bg-indigo-500 font-bold py-3.5 rounded-xl text-white transition flex items-center justify-center gap-2">
          <span>⚡</span> Buat Rangkuman AI Sekarang
        </button>
      </div>

      <!-- Result Box -->
      <div id="resultBox" class="hidden mt-6 p-4 bg-slate-900/90 border border-indigo-500/30 rounded-xl">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Hasil Rangkuman AI</span>
          <span class="text-xs text-slate-400">Siap Dipelajari</span>
        </div>
        <div id="outputContent" class="text-slate-300 text-sm leading-relaxed whitespace-pre-line"></div>
      </div>
    </div>
  </section>

  <!-- PRICING SECTION (MONETIZATION) -->
  <section id="pricing" class="max-w-5xl mx-auto px-4 py-12 w-full">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-white">Pilih Paket Belajar</h2>
      <p class="text-slate-400 mt-2">Mulai gratis atau buka semua fitur pro dengan harga terjangkau kantong siswa.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <!-- Free Plan -->
      <div class="bg-slate-800/50 border border-slate-700 rounded-2xl p-6 flex flex-col justify-between">
        <div>
          <h3 class="text-lg font-bold text-slate-200">Paket Basic</h3>
          <div class="text-3xl font-extrabold text-white mt-2">Rp0 <span class="text-sm text-slate-400 font-normal">/selamanya</span></div>
          <ul class="mt-6 space-y-3 text-sm text-slate-300">
            <li class="flex items-center gap-2">✓ 3 Rangkuman AI per hari</li>
            <li class="flex items-center gap-2">✓ Akses materi SMA standar</li>
            <li class="flex items-center gap-2 text-slate-500">✗ Latihan soal interaktif</li>
          </ul>
        </div>
        <button class="mt-8 w-full bg-slate-700 hover:bg-slate-600 text-white font-semibold py-2.5 rounded-xl transition">Gunakan Gratis</button>
      </div>

      <!-- Pro Plan -->
      <div class="bg-indigo-950/40 border-2 border-indigo-500 rounded-2xl p-6 flex flex-col justify-between relative overflow-hidden">
        <span class="bg-indigo-500 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg absolute top-0 right-0 uppercase tracking-wider">Paling Laris</span>
        <div>
          <h3 class="text-lg font-bold text-indigo-300">Paket Pro Siswa</h3>
          <div class="text-3xl font-extrabold text-white mt-2">Rp15.000 <span class="text-sm text-slate-400 font-normal">/bulan</span></div>
          <ul class="mt-6 space-y-3 text-sm text-slate-200">
            <li class="flex items-center gap-2">✓ <strong>Unlimited</strong> Rangkuman AI</li>
            <li class="flex items-center gap-2">✓ Generator Jadwal SNBT/UTBK</li>
            <li class="flex items-center gap-2">✓ Ekspor Rangkuman ke PDF</li>
          </ul>
        </div>
        <button onclick="subscribePro()" class="mt-8 w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 rounded-xl shadow-lg transition">Berlangganan Pro</button>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm mt-12">
    <p>© 2026 StudyMate AI — Proyek Wirausaha Digital SMA.</p>
  </footer>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    function generateSummary() {
      const subject = document.getElementById('subject').value;
      const notes = document.getElementById('inputNotes').value.trim();
      const resultBox = document.getElementById('resultBox');
      const output = document.getElementById('outputContent');

      resultBox.classList.remove('hidden');
      output.innerHTML = "<span class='text-indigo-400 animate-pulse'>🔄 AI sedang menganalisis dan merangkum...</span>";

      setTimeout(() => {
        let textResult = `📌 **Rangkuman AI [Mata Pelajaran: ${subject}]**\n\n`;
        
        if (notes !== "") {
          textResult += `1. **Konsep Utama:** AI telah mengekstraksi poin penting dari input kamu: "${notes.substring(0, 40)}..."\n`;
        } else {
          textResult += `1. **Poin Kunci:** Menguasai konsep dasar ${subject} sangat penting untuk ujian sekolah & tes masuk PTN.\n`;
        }

        textResult += `2. **Rekomendasi Belajar:** Fokus pada rumus/fakta utama, kerjakan 5 latihan soal, dan tinjau kembali dalam 24 jam.\n`;
        textResult += `3. **Tips Ujian:** Gunakan teknik *Spaced Repetition* untuk mengingat poin penting di atas.`;

        output.innerText = textResult;
      }, 1200);
    }

    function subscribePro() {
      alert("Terima kasih! Fitur pembayaran WhatsApp/E-Wallet akan segera dibuka untuk Paket Pro Siswa.");
    }
  </script>
</body>
</html>
